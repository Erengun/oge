Proposed from go.mod:

  # Öge project config. Check commands and test globs are the Oracle: they
  # decide acceptance, and no agent can change them during a Run.
  schema = 1

  [project]
  test_globs   = ["**/*_test.go", "**/testdata/**"]
  test_config  = ["go.mod", "go.sum"]
  output_globs = ["cmd/**/*.go", "internal/**/*.go"]   # other new files are Ambiguous until you decide

  [[check.commands]]
  run     = "go test -json ./..."
  report  = "go-test-json"
  timeout = "10m"

